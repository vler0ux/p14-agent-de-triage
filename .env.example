# Copier ce fichier en ".env" et renseigner vos propres valeurs.
# Ne JAMAIS committer le fichier ".env" réel (ajouter à .gitignore).

# Nécessaire si le dataset HuggingFace visé est privé/gated (rarement
# le cas pour MediQAl/FrenchMedMCQA/MedQuAD, mais à prévoir).
# Réservé pour un usage futur — pas encore utilisé dans le code actuel.
HF_TOKEN=

# Utilisé par filtre_pertinence.py (Étape 0), extraction_etape1.py (Étape 1),
# et par défaut pour l'Étape 4 (contre_validation_etape4.py) via llm_client.py.
# Clé gratuite sur console.groq.com/keys.
GROQ_API_KEY=

# Utilisé par llm_client.py (fournisseur "gemini"), par défaut pour l'Étape 3
# (labellisation_etape3.py) et l'Étape 1 dans orchestrer_pipeline.py.
# Clé gratuite sur Google AI Studio — les quotas du tier gratuit varient
# beaucoup selon le modèle, à vérifier au cas par cas.
GEMINI_API_KEY=

# Réservés pour un usage futur — pas encore utilisés dans le code actuel.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
