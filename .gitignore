# --- Données (régénérables via les scripts) ---
data/raw/
data/normalized/
data/anonymized/
data/relecture/
data/dpo/
dialogues/
# Journaux (conversations de la démo, logs de traduction / pipeline) : tout dossier logs/, où qu'il soit
logs/
*.log
# Tout fichier JSONL hors du dataset SFT (sorties de pipeline, dialogues, fichiers de nettoyage *_perimes / *_nettoye...)
*.jsonl
*.jsonl.avant_nettoyage
# Exception : le dataset SFT final est versionné (il sert d'entrée au notebook Kaggle).
# Le reste de data/sft/ (adaptateurs entraînés par train_sft.py, etc.) reste ignoré.
data/sft/*
!data/sft/train.jsonl
!data/sft/validation.jsonl

# --- Exports HTML de relecture / démonstration (contiennent des dialogues générés) ---
demo_dialogues.html
relecture_medecins.html

# --- Modèles entraînés, checkpoints, archives (plusieurs centaines de Mo chacun) ---
*qwen3-1.7b-triage-*/
checkpoint-*/
*.safetensors
*.bin
*.zip

# --- Copie des fichiers envoyés sur Kaggle (duplique src/entrainement/ et data/sft/) ---
